# Copy to .env and change PORT/DB_PATH if you need to.
PORT=8080
DB_PATH=./data/cashflow.db

# Comma-separated origins allowed to call the API (the installed app's origin).
# Leave empty during local development to allow http://localhost:*
ALLOWED_ORIGINS=

# Optional. Only used by scripts/reset-pin.js to create the first owner account.
BOOTSTRAP_OWNER_NAME=Owner
