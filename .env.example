# Copy to .env. Every value has a sensible default; none of this is required.
PORT=8080
DB_PATH=./data/cashflow.db

# The local AI used for plain-language explanations.
# Install Ollama (https://ollama.com), then: ollama pull llama3.2
# With nothing running here, the app writes its own explanations instead —
# from the same numbers, so they are still correct.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
